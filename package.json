{
  "name": "library-scheduler",
  "version": "1.0.0",
  "description": "Library shift-scheduling web app — static, runs on GitHub Pages",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=iife --target=es2020 --sourcemap",
    "dev": "node server.js",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=iife --target=es2020 --sourcemap --watch",
    "generate-samples": "node scripts/generate-sample-csvs.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.3"
  }
}
